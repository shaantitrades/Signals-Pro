# SignalsPro AI Signal Engine

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/signalspro
REDIS_URL=redis://localhost:6379
API_URL=http://localhost:3001/api
API_KEY=your_internal_api_key

# ── Data Providers (all FREE, no API keys needed) ──
CCXT_EXCHANGE=binance
# Forex/Indices/Commodities: yfinance (Yahoo Finance) — zero config, unlimited

# ── Engine Config ──
SIGNAL_MIN_CONFIDENCE=85
MAX_CONCURRENT_SIGNALS=10
ANALYSIS_INTERVAL_SECONDS=30
BACKTEST_LOOKBACK_DAYS=90

# ── OTC Config ──
OTC_SIGNAL_TIMEOUT=30
OTC_MIN_CONFIDENCE=80

# Logging
LOG_LEVEL=INFO

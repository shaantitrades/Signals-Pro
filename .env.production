# ============================================================================
# SignalsPro Production Environment Variables
# Copy this file to .env and fill in ALL values before deploying
# ============================================================================

# ─── Domain ─────────────────────────────────────────────────
DOMAIN=yourdomain.com

# ─── Database ───────────────────────────────────────────────
DB_NAME=signalspro
DB_USER=postgres
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD_MIN_32_CHARS

# ─── Redis ──────────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_PASSWORD

# ─── JWT Secrets (generate with: openssl rand -base64 64) ──
JWT_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL
JWT_REFRESH_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_DIFFERENT
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Stripe ─────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_your_stripe_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# ─── Signal Engine ──────────────────────────────────────────
ENGINE_API_KEY=CHANGE_ME_INTERNAL_ENGINE_KEY
SIGNAL_MIN_CONFIDENCE=85
ANALYSIS_INTERVAL_SECONDS=30
LOG_LEVEL=WARNING

# ─── External APIs (optional) ──────────────────────────────
TRADINGVIEW_API_KEY=
COINMARKETCAP_API_KEY=
ALPHA_VANTAGE_API_KEY=

# Server
PORT=3001
NODE_ENV=development
API_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000

# Database (PostgreSQL local via Docker)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/signalspro"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-in-production-min-32-chars"
JWT_REFRESH_SECRET="your-super-secret-refresh-key-change-in-production-min-32"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Stripe
STRIPE_SECRET_KEY="sk_test_your_stripe_key"
STRIPE_WEBHOOK_SECRET="whsec_your_webhook_secret"

# PayPal
PAYPAL_ENVIRONMENT="sandbox" # sandbox | production
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_WEBHOOK_ID=""

# External APIs
TRADINGVIEW_API_KEY=""
COINMARKETCAP_API_KEY=""
ALPHA_VANTAGE_API_KEY=""

# Signal Engine (Python)
SIGNAL_ENGINE_URL="http://localhost:8000"

# Logging
LOG_LEVEL=debug

// ============================================================================
// Market Signals24 - Database Schema
// SQLite (dev) / PostgreSQL (prod)
// ============================================================================

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// USER & AUTH
// ============================================================================

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  passwordHash  String?  @map("password_hash")
  googleId      String?  @unique @map("google_id")
  firstName     String   @map("first_name")
  lastName      String   @map("last_name")
  phone         String?  @map("phone")
  stripeCustomerId String? @unique @map("stripe_customer_id")
  role          String   @default("USER") // USER, VALIDATOR, ADMIN, SUPER_ADMIN
  isActive      Boolean  @default(true) @map("is_active")
  emailVerified Boolean  @default(false) @map("email_verified")
  avatarUrl     String?  @map("avatar_url")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  subscription  Subscription?
  trades        UserTrade[]
  validations   SignalValidation[] @relation("ValidatorRelation")
  botConfigs    BotConfig[]
  alerts        UserAlert[]
  refreshTokens RefreshToken[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

// ============================================================================
// SIGNALS
// ============================================================================

model Signal {
  id               String   @id @default(uuid())
  asset            String
  category         String   // FOREX_OTC, FOREX, CRYPTO, INDICES, COMMODITIES
  action           String   // BUY, SELL
  entryPrice       Decimal  @map("entry_price")
  takeProfit1      Decimal  @map("take_profit_1")
  takeProfit2      Decimal? @map("take_profit_2")
  takeProfit3      Decimal? @map("take_profit_3")
  stopLoss         Decimal  @map("stop_loss")
  timeframe        String   // M1, M5, M15, M30, H1, H4, D1, W1
  confidenceScore  Float    @map("confidence_score")
  riskLevel        String   @default("MEDIUM") @map("risk_level")
  status           String   @default("PENDING")
  validationStatus String   @default("PENDING_AI") @map("validation_status")

  actualExitPrice  Decimal? @map("actual_exit_price")
  pnlPips          Float?   @map("pnl_pips")
  pnlPercent       Float?   @map("pnl_percent")
  result           String?

  analysis         String?
  marketContext    String?  @map("market_context")
  indicators       String?

  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  expiresAt        DateTime? @map("expires_at")
  executedAt       DateTime? @map("executed_at")
  closedAt         DateTime? @map("closed_at")

  validations      SignalValidation[]
  userTrades       UserTrade[]
  auditLogs        SignalAuditLog[]

  @@index([category, status])
  @@index([asset, status])
  @@index([createdAt])
  @@index([confidenceScore])
  @@map("signals")
}

// ============================================================================
// SIGNAL VALIDATION
// ============================================================================

model SignalValidation {
  id              String   @id @default(uuid())
  signalId        String   @map("signal_id")
  validatorId     String?  @map("validator_id")
  validationType  String   @map("validation_type")
  result          String
  confidenceScore Float?   @map("confidence_score")
  notes           String?
  metadata        String?

  createdAt       DateTime @default(now()) @map("created_at")

  signal          Signal   @relation(fields: [signalId], references: [id], onDelete: Cascade)
  validator       User?    @relation("ValidatorRelation", fields: [validatorId], references: [id])

  @@index([signalId])
  @@map("signal_validations")
}

// ============================================================================
// USER TRADES
// ============================================================================

model UserTrade {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  signalId       String   @map("signal_id")
  executionPrice Decimal  @map("execution_price")
  exitPrice      Decimal? @map("exit_price")
  lotSize        Decimal  @map("lot_size")
  result         String?
  pnlAmount      Decimal? @map("pnl_amount")
  pnlPips        Float?   @map("pnl_pips")
  pnlPercent     Float?   @map("pnl_percent")
  isAutoExecuted Boolean  @default(false) @map("is_auto_executed")

  executedAt     DateTime  @default(now()) @map("executed_at")
  closedAt       DateTime? @map("closed_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  user           User   @relation(fields: [userId], references: [id])
  signal         Signal @relation(fields: [signalId], references: [id])

  @@index([userId, createdAt])
  @@index([signalId])
  @@map("user_trades")
}

// ============================================================================
// SUBSCRIPTIONS & PRICING
// ============================================================================

model SubscriptionPlan {
  id            String   @id @default(uuid())
  name          String
  slug          String   @unique
  priceEur      Decimal  @map("price_eur")
  durationDays  Int      @map("duration_days")
  features      String   // JSON string
  isActive      Boolean  @default(true) @map("is_active")
  stripePriceId String?  @map("stripe_price_id")
  sortOrder     Int      @default(0) @map("sort_order")

  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  subscriptions Subscription[]

  @@map("subscription_plans")
}

model Subscription {
  id                 String   @id @default(uuid())
  userId             String   @unique @map("user_id")
  planId             String   @map("plan_id")
  status             String   @default("ACTIVE")
  stripeSubId        String?  @map("stripe_subscription_id")
  currentPeriodStart DateTime @map("current_period_start")
  currentPeriodEnd   DateTime @map("current_period_end")
  canceledAt         DateTime? @map("canceled_at")

  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  user               User             @relation(fields: [userId], references: [id])
  plan               SubscriptionPlan @relation(fields: [planId], references: [id])
  payments           Payment[]

  @@map("subscriptions")
}

model Payment {
  id              String   @id @default(uuid())
  subscriptionId  String   @map("subscription_id")
  amount          Decimal
  currency        String   @default("EUR")
  status          String   @default("PENDING")
  stripePaymentId String?  @map("stripe_payment_id")
  nowPaymentId    String?  @unique @map("now_payment_id")
  provider        String   @default("stripe") // stripe | nowpayments

  createdAt       DateTime @default(now()) @map("created_at")

  subscription    Subscription @relation(fields: [subscriptionId], references: [id])

  @@map("payments")
}

// ============================================================================
// BOT CONFIGURATION
// ============================================================================

model BotConfig {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  name            String   @default("My Bot")
  category        String
  assets          String   @default("[]")
  timeframes      String   @default("[]")
  isActive        Boolean  @default(false) @map("is_active")

  maxConcurrent     Int     @default(3) @map("max_concurrent_signals")
  riskPerTrade      Decimal @default(2.0) @map("risk_per_trade")
  maxDailyLoss      Decimal? @default(5.0) @map("max_daily_loss")
  minConfidence     Float   @default(85.0) @map("min_confidence_score")
  allowedRiskLevels String  @default("[]") @map("allowed_risk_levels")

  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  user              User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("bot_configs")
}

// ============================================================================
// ALERTS
// ============================================================================

model UserAlert {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  type        String
  title       String
  message     String
  isRead      Boolean  @default(false) @map("is_read")
  metadata    String?

  createdAt   DateTime @default(now()) @map("created_at")

  user        User @relation(fields: [userId], references: [id])

  @@index([userId, isRead])
  @@map("user_alerts")
}

// ============================================================================
// AUDIT LOG
// ============================================================================

model SignalAuditLog {
  id        String   @id @default(uuid())
  signalId  String   @map("signal_id")
  action    String
  details   String?
  userId    String?  @map("user_id")

  createdAt DateTime @default(now()) @map("created_at")

  signal    Signal @relation(fields: [signalId], references: [id], onDelete: Cascade)

  @@index([signalId, createdAt])
  @@map("signal_audit_logs")
}

// ============================================================================
// PERFORMANCE METRICS
// ============================================================================

model PerformanceMetric {
  id            String   @id @default(uuid())
  category      String
  asset         String?
  timeframe     String?
  period        String
  periodDate    DateTime @map("period_date")

  totalSignals  Int   @default(0) @map("total_signals")
  winCount      Int   @default(0) @map("win_count")
  lossCount     Int   @default(0) @map("loss_count")
  winRate       Float @default(0) @map("win_rate")
  totalPips     Float @default(0) @map("total_pips")
  avgPips       Float @default(0) @map("avg_pips")
  maxDrawdown   Float @default(0) @map("max_drawdown")
  profitFactor  Float @default(0) @map("profit_factor")
  sharpeRatio   Float? @map("sharpe_ratio")

  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@unique([category, asset, timeframe, period, periodDate])
  @@map("performance_metrics")
}

// ============================================================================
// ASSETS
// ============================================================================

model Asset {
  id            String   @id @default(uuid())
  symbol        String   @unique
  name          String
  category      String
  isActive      Boolean  @default(true) @map("is_active")
  pipSize       Decimal  @map("pip_size")
  minLotSize    Decimal  @default(0.01) @map("min_lot_size")
  maxLotSize    Decimal  @default(100.0) @map("max_lot_size")
  tradingHours  String?  @map("trading_hours")

  createdAt     DateTime @default(now()) @map("created_at")

  @@map("assets")
}
